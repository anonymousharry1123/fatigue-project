{
  "functions": [{
    "source": "functions",
    "codebase": "oura",
    "ignore": ["node_modules", ".git", "test", "*.local", "README.md"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" test"]
  }],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
