{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tonyo (Firebase)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "templateFor": "app/lib",
      "toolArgs": [
        "--dart-define-from-file=config/firebase_options.json"
      ]
    },
    {
      "name": "Tonyo (Edge, fixed port)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "deviceId": "edge",
      "toolArgs": [
        "--web-port=7357",
        "--dart-define-from-file=config/firebase_options.json"
      ]
    },
    {
      "name": "Tonyo (Edge, local-only)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "deviceId": "edge",
      "toolArgs": ["--web-port=7357"]
    }
  ]
}
