{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tonyo (Firebase)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "templateFor": "app/lib"
    },
    {
      "name": "Tonyo (Edge, fixed port)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "deviceId": "edge",
      "toolArgs": ["--web-port=7357"]
    }
  ]
}
