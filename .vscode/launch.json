{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tonyo (Edge, fixed port)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "app",
      "deviceId": "edge",
      "args": [
        "--web-port=7357",
        "--dart-define-from-file=config/firebase_options.json"
      ]
    },
    {
      "name": "Tonyo (Edge, local-only)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "app",
      "deviceId": "edge",
      "args": ["--web-port=7357"]
    }
  ]
}
